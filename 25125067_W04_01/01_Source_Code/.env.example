# Offline fixture; no credentials or network needed. Not an exam quality benchmark.
EXAM_PROVIDER=mock
EXAM_MODEL=mock-fixture-v1
EXAM_PROMPT_VERSION=v1
EXAM_MAX_PROMPT_CHARS=200000
# Optional multimodal adapter capability. Native TikZ pipeline inspects source code
# and does not require images/vision; leave false unless an image adapter is used.
EXAM_SUPPORTS_IMAGES=false

# For a real Chat Completions compatible service:
# EXAM_PROVIDER=chat_completions
# EXAM_MODEL=<your-enabled-model>
# EXAM_API_KEY=<secret>
EXAM_BASE_URL=https://api.openai.com/v1
# Google's compatible endpoint uses a Google key and an enabled Gemini model:
# EXAM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# EXAM_TOKEN_LIMIT_FIELD=max_tokens
EXAM_TIMEOUT_SECONDS=90
EXAM_MAX_OUTPUT_TOKENS=8192
# Some compatible services use max_tokens instead.
EXAM_TOKEN_LIMIT_FIELD=max_completion_tokens
# json_object or text; Pydantic validates the response in both modes.
EXAM_RESPONSE_FORMAT=json_object
# Omitted by default: model support varies. No per-model branches in the agent.
# EXAM_TEMPERATURE=0
# EXAM_SEED=42

# Optional user-configured USD per million tokens; no hardcoded prices.
# Configure BOTH rates to obtain an estimate (including a zero rate).
# EXAM_INPUT_PRICE_PER_MILLION=0
# EXAM_OUTPUT_PRICE_PER_MILLION=0

# Optional append-only local evaluation records. Includes fingerprints, not exam text.
# EXAM_EVALUATION_JSONL=runs/evaluations.jsonl
